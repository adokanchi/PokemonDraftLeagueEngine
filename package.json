{
	"name": "pokemon-draft-league-engine",
	"version": "0.1.0",
	"private": true,
	"description": "Analysis and practice engine for Pokemon Champions VGC draft league matches (team building, team preview, turn decisions).",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"setup": "node scripts/setup-showdown.mjs",
		"pretest": "node scripts/check-setup.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"bench": "tsx scripts/bench.ts",
		"validate": "tsx scripts/validate-team.ts",
		"parse-log": "tsx scripts/parse-log.ts",
		"check-parser": "tsx scripts/check-parser.ts",
		"check-illusion": "tsx scripts/check-illusion.ts",
		"fetch-usage": "tsx scripts/fetch-usage.ts",
		"arena": "tsx scripts/arena.ts",
		"advise": "tsx scripts/advise.ts",
		"check-damage": "tsx scripts/check-damage.ts",
		"check-reconstruct": "tsx scripts/check-reconstruct.ts",
		"check-sets": "tsx scripts/check-sets.ts",
		"practice": "tsx scripts/practice.ts",
		"server": "node vendor/pokemon-showdown/pokemon-showdown start --no-security 8000",
		"preview": "tsx scripts/preview.ts",
		"fetch-replays": "tsx scripts/fetch-replays.ts",
		"replay-stats": "tsx scripts/replay-stats.ts",
		"extract-positions": "tsx scripts/extract-positions.ts",
		"check-labels": "tsx scripts/check-labels.ts"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
